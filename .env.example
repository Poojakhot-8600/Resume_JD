# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Application URL
# Local: http://localhost:3000
# Production (Hostinger): https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Client Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
PRISMA_CLIENT_ENGINE_TYPE="library"

# Optional JWT Signing Secret (server-only)
JWT_SECRET="your-256-bit-jwt-secret-key-min-32-chars"

# Hostinger n8n Webhook URLs (Docker port 32769 or custom domain)
N8N_JD_WEBHOOK_URL="http://200.97.175.212:32769/webhook/jd-upload"
N8N_CANDIDATE_RESUME_WEBHOOK_URL="http://200.97.175.212:32769/webhook/resume-insert"
NEXT_PUBLIC_N8N_JD_WEBHOOK_URL="http://200.97.175.212:32769/webhook/jd-upload"
NEXT_PUBLIC_N8N_CANDIDATE_RESUME_WEBHOOK_URL="http://200.97.175.212:32769/webhook/resume-insert"

# ==============================================================================
# SESSION TIMEOUT & COOKIE CONFIGURATION
# ==============================================================================
# Inactivity idle timeout before auto-logout (in minutes)
SESSION_IDLE_TIMEOUT_MINUTES=20
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MINUTES=20

# Countdown warning dialog shown before session expiry (in seconds)
# Default: 60 seconds (warning dialog appears at 19 minutes for 20-min timeout)
SESSION_WARNING_SECONDS=60
NEXT_PUBLIC_SESSION_WARNING_SECONDS=60

# Maximum absolute session lifespan (in hours) regardless of user activity
SESSION_MAX_HOURS=8

# Session cookie name
COOKIE_NAME="auth_token"

# Cookie SameSite attribute ('lax', 'strict', or 'none')
COOKIE_SAMESITE="lax"

# Cookie Secure flag:
# - Local (http://localhost:3000): MUST be false
# - Production (https://...): MUST be true
COOKIE_SECURE=false

# Cookie domain: leave empty for current host; set if sharing across subdomains
COOKIE_DOMAIN=""
